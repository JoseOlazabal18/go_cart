# Configuracion de correo para recuperacion de contrasena.
# Si estas variables no existen, Go Cart intentara usar la tabla `token` de la base de datos.

GO_CART_MAIL_HOST=
GO_CART_MAIL_PORT=587
GO_CART_MAIL_USERNAME=
GO_CART_MAIL_PASSWORD=
GO_CART_MAIL_ENCRYPTION=tls
GO_CART_MAIL_FROM=
GO_CART_MAIL_FROM_NAME=Go Cart
